requests
| where timestamp > ago(24h)
| extend prompt = coalesce(tostring(customDimensions["aap.prompt_ref"]), tostring(customDimensions["aap.prompt"]), tostring(customDimensions["prompt_ref"]))
| summarize requests = count(), failed = countif(success == false), p95_ms = percentile(duration, 95) by prompt, bin(timestamp, 15m)
| order by timestamp desc
