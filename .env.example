# Default: everything runs offline with deterministic mocks.
AAP_MODE=offline            # offline | azure
AAP_TENANT_ID=contoso-mortgage

# --- Set by `azd up` (azd env get-values) when AAP_MODE=azure ---
FOUNDRY_PROJECT_ENDPOINT=   # https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5-mini    # chat deployment name
FOUNDRY_FALLBACK_MODEL=     # optional smaller / paired-region deployment
AZURE_OPENAI_ENDPOINT=      # https://<account>.openai.azure.com/ (evaluators)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_GUIDELINES_INDEX=investor-guidelines
AZURE_SEARCH_HR_INDEX=hr-policies
AZURE_DOCINTEL_ENDPOINT=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=agentplatform
AZURE_SERVICEBUS_NAMESPACE=  # <ns>.servicebus.windows.net
AZURE_CLIENT_ID=             # user-assigned managed identity client id (Container Apps)
APPLICATIONINSIGHTS_CONNECTION_STRING=
