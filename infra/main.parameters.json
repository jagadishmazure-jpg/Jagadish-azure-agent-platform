{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "costProfile": { "value": "${AAP_COST_PROFILE=cost-min}" },
    "privateLink": { "value": "${AAP_PRIVATE_LINK=false}" },
    "enableAlerts": { "value": "${AAP_ENABLE_ALERTS=true}" },
    "alertEmail": { "value": "${AAP_ALERT_EMAIL=}" },
    "enableDefender": { "value": "${AAP_ENABLE_DEFENDER=false}" },
    "deployVendorStandins": { "value": "${AAP_DEPLOY_STANDINS=false}" },
    "chatModelName": { "value": "${AAP_CHAT_MODEL=gpt-5-mini}" },
    "chatModelVersion": { "value": "${AAP_CHAT_MODEL_VERSION=2025-08-07}" },
    "apimPublisherEmail": { "value": "${AAP_APIM_PUBLISHER_EMAIL=noreply@example.com}" },
    "entraTenantId": { "value": "${AAP_ENTRA_TENANT_ID=}" },
    "entraAudience": { "value": "${AAP_ENTRA_AUDIENCE=}" }
  }
}
